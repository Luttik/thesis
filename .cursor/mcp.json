{
  "mcpServers": {
    "consensus": {
      "url": "https://mcp.consensus.app/mcp"
    },
    "qdrant-pdf-knowledge": {
      "command": "uvx",
      "args": [
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://localhost:6333",
        "COLLECTION_NAME": "thesis-knowledge-base",
        "EMBEDDING_MODEL": "BAAI/bge-small-en-v1.5"
      }
    }
  }
}
