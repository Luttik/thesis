# =============================================================================
# PDF-VectorDB Configuration
# =============================================================================
# Copy this file to .env and fill in the values.

# Datalab API key (required) -- get yours at https://www.datalab.to/settings
DATALAB_API_KEY=

# Qdrant connection
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=pdf-knowledge-base

# Embedding model -- must match the model configured in the MCP server
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Folder paths (relative to project root)
RAW_SOURCES_DIR=raw-sources
MD_SOURCES_DIR=md-sources

# Datalab conversion mode: "fast", "balanced", or "accurate"
# "accurate" is recommended for academic papers ($6/1000 pages)
CONVERSION_MODE=accurate

# Chunking settings
CHUNK_MAX_TOKENS=1500
CHUNK_OVERLAP_TOKENS=200
